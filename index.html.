

<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Nightlife Scanner | UK Club Events</title>

  <style>

    * { box-sizing: border-box; }

    body {

      margin: 0;

      font-family: Arial, sans-serif;

      background: #101018;

      color: #fff;

    }

    header {

      padding: 35px 20px;

      text-align: center;

      background: linear-gradient(135deg, #28104a, #101018);

    }

    header h1 {

      margin: 0 0 10px;

      font-size: clamp(30px, 6vw, 48px);

    }

    header p { color: #d1c4e9; }

    main { max-width: 1000px; margin: auto; padding: 24px 16px; }

    input, select {

      width: 100%;

      padding: 12px;

      border-radius: 8px;

      border: 1px solid #454553;

      background: #20202c;

      color: white;

      margin: 5px 0 12px;

    }

    .filters {

      display: grid;

      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));

      gap: 12px;

    }

    .events {

      display: grid;

      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));

      gap: 16px;

    }

    .event {

      padding: 20px;

      background: #20202c;

      border: 1px solid #383846;

      border-radius: 12px;

    }

    .event h2 { margin-top: 0; font-size: 21px; }

    .tag {

      display: inline-block;

      background: #50258a;

      padding: 5px 9px;

      border-radius: 20px;

      font-size: 12px;

    }

    a { color: #d6b5ff; }

    .source { font-size: 12px; color: #b8b8c8; }

    footer { text-align: center; padding: 30px; color: #aaa; }

  </style>

</head>

<body>

  <header>

    <h1>NIGHTLIFE SCANNER</h1>

    <p>Discover club nights, DJs and dance music across the UK.</p>

  </header>

  <main>

    <h2>Find your next night out</h2>

    <div class="filters">

      <label>Search events or DJs

        <input id="search" placeholder="Search house, DJs, clubs...">

      </label>

      <label>Town or city

        <select id="city">

          <option value="">All UK locations</option>

          <option>Edinburgh</option>

          <option>Glasgow</option>

          <option>London</option>

          <option>Manchester</option>

          <option>Birmingham</option>

          <option>Fife</option>

        </select>

      </label>

      <label>Music genre

        <select id="genre">

          <option value="">All genres</option>

          <option>House</option>

          <option>Disco</option>

          <option>Techno</option>

          <option>Trance</option>

          <option>Drum and bass</option>

        </select>

      </label>

    </div>

    <p id="count" aria-live="polite"></p>

    <div id="events" class="events"></div>

  </main>

  <footer>

    Nightlife Scanner · UK club and DJ directory

  </footer>

<script>
  let events = [];

  const search = document.getElementById("search");
  const city = document.getElementById("city");
  const genre = document.getElementById("genre");
  const count = document.getElementById("count");
  const eventsContainer = document.getElementById("events");

  function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    })[char]);
  }

  function renderEvents() {
    const query = search.value.toLowerCase().trim();

    const filtered = events.filter(event => {
      const searchable = [
        event.title,
        event.city,
        event.venue,
        event.dj,
        event.genre
      ].join(" ").toLowerCase();

      return searchable.includes(query) &&
        (!city.value || event.city === city.value) &&
        (!genre.value || event.genre === genre.value);
    });

    count.textContent = filtered.length +
      " verified event(s) listed";

    if (filtered.length === 0) {
      eventsContainer.innerHTML =
        "<p>No events found. Check back for new listings.</p>";
      return;
    }

    eventsContainer.innerHTML = filtered.map(event => {
      const eventLink = /^https?:\/\//i.test(event.url || "")
        ? `<p><a href="${escapeHTML(event.url)}" target="_blank" rel="noopener noreferrer">View original event</a></p>`
        : "";

      return `
        <article class="event">
          <span class="tag">${escapeHTML(event.genre)}</span>
          <h2>${escapeHTML(event.title)}</h2>
          <p><strong>${escapeHTML(event.city)}</strong></p>
          <p>${escapeHTML(event.venue)}</p>
          <p>Date: ${escapeHTML(event.date)}</p>
          <p>DJs: ${escapeHTML(event.dj)}</p>
          ${eventLink}
          <p class="source">Source: ${escapeHTML(event.source || "Event listing")}</p>
        </article>
      `;
    }).join("");
  }

  async function loadEvents() {
    count.textContent = "Loading events...";

    try {
      const response = await fetch("./events.json", {
        cache: "no-store"
      });

      if (!response.ok) {
        throw new Error("Could not load event database");
      }

      const data = await response.json();
      events = Array.isArray(data.events) ? data.events : [];

      renderEvents();
    } catch (error) {
      count.textContent = "Unable to load events. Please try again later.";
      eventsContainer.innerHTML = "";
    }
  }

  [search, city, genre].forEach(control => {
    control.addEventListener("input", renderEvents);
    control.addEventListener("change", renderEvents);
  });

  loadEvents();
</script>


  
